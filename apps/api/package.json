{
  "name": "@eduflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node scripts/with-env.cjs nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "db:generate": "node scripts/with-env.cjs prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/with-env.cjs prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node scripts/with-env.cjs prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@eduflow/contracts": "0.1.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pdf-parse": "2.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.6",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.1",
    "jest": "30.1.3",
    "prisma": "6.19.3",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
