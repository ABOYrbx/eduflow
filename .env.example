# EduFlow – lokale Secrets
# Datei als `.env` neben app.py anlegen und Keys eintragen.

# OpenWeatherMap-Key für die Wetterkarte (https://home.openweathermap.org/api_keys)
OPENWEATHER_KEY=

# Wetter-Standort: entweder Koordinaten (genau, gehen vor) …
# Beispiel Wien: WEATHER_LAT=48.21
#                 WEATHER_LON=16.37
WEATHER_LAT=
WEATHER_LON=

# … oder einfach nur die Stadt (wird ignoriert, falls Koordinaten gesetzt sind).
# Format: Name[,Ländercode], z. B. Wien oder Wien,AT
WEATHER_CITY=

# Optional: eigene Schlüssel statt Autogenerierung (.eduflow_secret / .eduflow.key)
# FLASK_SECRET_KEY=
# EDUFLOW_KEY=
