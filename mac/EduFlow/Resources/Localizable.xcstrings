    "settings_navbar_desc" : {
      "comment" : "Einstellungen: Navigationsleiste Beschreibung",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, welche Bereiche oben erscheinen und in welcher Reihenfolge. Termine bleiben auch ohne Reiter über das Profilmenü erreichbar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الأقسام التي تظهر في الأعلى وفي أي ترتيب. تبقى الأحداث قابلة للوصول عبر قائمة الملف الشخصي حتى بدون علامة تبويب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, welche Bereiche oben erscheinen und in welcher Reihenfolge. Termine bleiben auch ohne Reiter über das Profilmenü erreichbar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ve kterých sekcích se zobrazí nahoře. Události zůstanou dosažitelné v nabídce profilu i bez záložky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg hvilke sektioner der vises øverst og i hvilken rækkefølge. Begivenheder forbliver tilgængelige via profilmenuen selv uden en fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus, welche Bereiche oben und in welcher Reihenfolge angezeigt werden. Events bleiben auch ohne Tab erreichbar über das Profilmenü."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ποιες ενότητες εμφανίζονται στην κορυφή και με ποια σειρά. Τα γεγονότα παραμένουν προσβάσιμα μέσω του μενού προφίλ ακόμη και χωρίς καρτέλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which sections appear on top and in which order. Events stay reachable via the profile menu even without a tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija qué secciones aparecen en la parte superior y en qué orden. Los eventos permanecen accesibles a través del menú de perfil incluso sin una pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse mitkä osat näkyvät päällä ja missä järjestyksessä. Tapahtumat pysyvät tavoitettavissa profiilivalikon kautta ilman välilehteä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les sections qui apparaissent en haut et dans quelle commande. Les événements restent accessibles via le menu du profil, même sans onglet."
