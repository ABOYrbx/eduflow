    "EduFlow spricht deine Sprache. Die Auswahl wird nach einem Neustart aktiv.": {
      "comment": "Onboarding: Sprachauswahl",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow spricht deine Sprache. Die Auswahl wird nach einem Neustart aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow speaks your language. The choice applies after a restart."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow يتحدث لغتك. ينطبق الخيار بعد إعادة التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow mluví vaším jazykem. Volba bude platit po restartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow taler dit sprog. Valget gælder efter en genstart."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το EduFlow μιλάει τη γλώσσα σας. Η επιλογή εφαρμόζεται μετά την επανεκκίνηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow habla su idioma. La elección se aplica después de un reinicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow puhuu kieltäsi. Valinta pätee uudelleenkäynnistyksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow parle votre langue. Le choix s'applique après un redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow parla la tua lingua. La scelta si applica dopo un riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow はあなたの言語を話します。選択は再起動後に適用されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow spreekt uw taal. De keuze is van toepassing na een herstart."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow snakker språket ditt. Valget gjelder etter en omstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow mówi twoim językiem. Wybór dotyczy po ponownym uruchomieniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow fala sua língua. A escolha se aplica após reiniciar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow fala sua língua. A escolha se aplica após reiniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow vorbește limba ta. Alegerea se aplică după o repornire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow говорит на вашем языке. Выбор применим после перезапуска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "EduFlow talar ditt språk. Valet gäller efter en omstart."
