    "auth_ready_detail": {
      "comment": "Anmeldung: bereit-Detail",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server und Gerät sind eingetragen.\nJetzt nur noch anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server and device are set.\nNow just sign in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إعداد الخادم والجهاز.\nالآن فقط تسجيل الدخول."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server a zařízení jsou nastaveny.\nNyní se jen přihlašte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Server og enhed er konfigureret.\nNu skal du logge ind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακομιστής και συσκευή έχουν ρυθμιστεί.\nΤώρα απλά εισέλθετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor y dispositivo están configurados.\nAhora solo inicia sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ja laite on asetettu.\nKirjaudu sisään nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur et l'appareil sont configurés.\nMaintenant, connectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server e il dispositivo sono configurati.\nOra accedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとデバイスが設定されています。\n今すぐサインインしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Server en apparaat zijn ingesteld.\nNu meldt u zich aan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren og enheten er satt opp.\nNå logger du bare på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer i urządzenie są skonfigurowane.\nTeraz zaloguj się."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul și dispozitivul sunt configurate.\nAcum doar conectați-vă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер и устройство настроены.\nТеперь просто войдите в систему."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Server och enhet är konfigurerade.\nNu är det bara att logga in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер і пристрій налаштовані.\nТепер просто увійдіть в систему."
          }
        }
      }
    },
